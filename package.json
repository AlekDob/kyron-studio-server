{
  "name": "studio-server",
  "version": "0.1.0",
  "description": "Studio server — horizontal agentic backend (Studio Futuro). Tenant-aware via X-Tenant header. Today serves Kyron (studio.kyronedu.it), tomorrow N clients.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@hono/node-server": "^1.13.0",
    "ai": "^4.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.1.0"
  }
}
