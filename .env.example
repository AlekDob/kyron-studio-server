# studio-server — backend agentico orizzontale Studio Futuro
# Tenant-aware via header X-Tenant. Vedi MIGRATION-FROM-SPACESHIP.md.

PORT=8790
NODE_ENV=development

# CORS: lista CSV degli origin frontend autorizzati
CORS_ORIGIN=http://localhost:3010,https://studio.kyronedu.it

# AI SDK (fallback) — in produzione le API key vivono in data/settings.json,
# editabili dalla UI Studio -> Impostazioni. Queste env restano come fallback
# se il file settings.json non esiste o non ha quel provider configurato.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Dove vive settings.json. Default: ./data (rispetto a process.cwd()).
# In Coolify configurare un volume persistente montato qui.
SETTINGS_DATA_DIR=

# Tenant Kyron — Payload REST endpoint per la collection PendingSchools
TENANT_KYRON_PAYLOAD_API_URL=http://localhost:3000/api

# PostHog Cloud EU — Query API per il modulo Analytics (decision-017).
# POSTHOG_API_KEY = personal API key con scope query:read (SEGRETO server-side,
# diverso dal token phc_ pubblico di ingestion). Project ID da Settings -> Project.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
