# studio-server — backend agentico orizzontale Studio Futuro
# Tenant-aware via header X-Tenant. Vedi MIGRATION-FROM-SPACESHIP.md.

PORT=8790
NODE_ENV=development

# CORS: lista CSV degli origin frontend autorizzati
CORS_ORIGIN=http://localhost:3010,https://studio.kyronedu.it

# AI SDK (fallback) — in produzione le API key vivono in data/settings.json,
# editabili dalla UI Studio -> Impostazioni. Queste env restano come fallback
# se il file settings.json non esiste o non ha quel provider configurato.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Dove vive settings.json. Default: ./data (rispetto a process.cwd()).
# In Coolify configurare un volume persistente montato qui.
SETTINGS_DATA_DIR=

# Tenant Kyron — Payload REST endpoint per la collection PendingSchools
TENANT_KYRON_PAYLOAD_API_URL=http://localhost:3000/api

# PostHog Cloud EU — Query API per il modulo Analytics (decision-017).
# POSTHOG_API_KEY = personal API key con scope query:read (SEGRETO server-side,
# diverso dal token phc_ pubblico di ingestion). Project ID da Settings -> Project.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com

# Enable portale (Fase B pipeline onboarding) — seed Saleor server-side.
# Credenziali ADMIN Saleor (le stesse di staging/prod, vedi kyron-ecommerce-ops).
SALEOR_ADMIN_EMAIL=
SALEOR_ADMIN_PASSWORD=
# Override URL (default api-staging.kyronedu.it / api.kyronedu.it)
SALEOR_STAGING_URL=
SALEOR_PROD_URL=
# URL GraphQL del gateway prodotti + report ordini (in PROD: api.kyronedu.it)
SALEOR_API_URL=https://api-staging.kyronedu.it/graphql/
# App token Saleor con MANAGE_ORDERS (accesso GLOBALE ai channel) per leggere
# TUTTI gli ordini nel report giornaliero. Un admin staff con
# restrictedAccessToChannels vedrebbe 0 ordini (gotcha Danea). Stesso token
# dell'export Danea.
SALEOR_APP_TOKEN=

# Resend (stessa key del cms) — report analytics + ordini + mail "portale live"
RESEND_API_KEY=
# Destinatari mail portale live (CSV; default info@kyronedu.it,gmail@alekdob.com)
PORTAL_LIVE_NOTIFY_TO=

# Report email giornalieri (scheduler in-process, Europe/Rome). Opt-in.
# Analytics: 09:00. Ordini: 09:30 (ordini di ieri da Saleor prod, per portale).
ANALYTICS_REPORT_ENABLED=false
ANALYTICS_REPORT_TO=team@kyronedu.it,gmail@alekdob.com
ORDERS_REPORT_ENABLED=false
ORDERS_REPORT_TO=team@kyronedu.it,gmail@alekdob.com
# Email escluse dal report ordini (smoke test del checkout). CSV.
ORDERS_REPORT_EXCLUDE_EMAILS=alekdobrohotov@gmail.com,gmail@alekdob.com

# Linear — modulo Richieste (Ivo, feature 022). Personal API key di Alek:
# apre i ticket nel progetto Kyron. Senza, il modulo risponde "non configurata".
LINEAR_API_KEY=
# Chi riceve la mail quando un collega apre una richiesta (CSV).
REQUESTS_NOTIFY_TO=gmail@alekdob.com
